<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<VBox alignment="TOP_CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.ppadalka.pdfmetadataeditor.PDFMetadataEditorView">
    <MenuBar>
        <Menu text="%menu.file">
            <MenuItem text="%menu.file.open" onAction="#onFileOpen"/>
            <MenuItem text="%menu.file.save" onAction="#onFileSave"/>
        </Menu>
    </MenuBar>
    <GridPane hgap="10" vgap="10">
        <padding>
            <Insets topRightBottomLeft="20"/>
        </padding>
        <!-- File name -->
        <Label text="%label.file"
               GridPane.rowIndex="0"
               GridPane.columnIndex="0"/>
        <Text fx:id="fileName"
              GridPane.rowIndex="0"
              GridPane.columnIndex="1"/>
        <!-- Title -->
        <Label text="%label.title"
               GridPane.rowIndex="1"
               GridPane.columnIndex="0"/>
        <TextField fx:id="title"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="1"
                   disable="true"/>
        <!-- Author -->
        <Label text="%label.author"
               GridPane.rowIndex="2"
               GridPane.columnIndex="0"/>
        <TextField fx:id="author"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="1"
                   disable="true"/>
        <!-- Subject -->
        <Label text="%label.subject"
               GridPane.rowIndex="3"
               GridPane.columnIndex="0"/>
        <TextField fx:id="subject"
                   GridPane.rowIndex="3"
                   GridPane.columnIndex="1"
                   disable="true"/>
        <!-- Keywords -->
        <Label text="%label.keywords"
               GridPane.rowIndex="4"
               GridPane.columnIndex="0" />
        <TextArea fx:id="keywords"
                  GridPane.rowIndex="4"
                  GridPane.columnIndex="1"
                  disable="true"/>
        <!-- Created -->
        <Label text="%label.created"
               GridPane.rowIndex="5"
               GridPane.columnIndex="0"/>
        <Text fx:id="created"
              GridPane.rowIndex="5"
              GridPane.columnIndex="1"/>
        <!-- Modified -->
        <Label text="%label.modified"
               GridPane.rowIndex="6"
               GridPane.columnIndex="0"/>
        <Text fx:id="modified"
              GridPane.rowIndex="6"
              GridPane.columnIndex="1"/>
    </GridPane>
    <HBox alignment="TOP_RIGHT" spacing="10">
        <padding>
            <Insets topRightBottomLeft="20"/>
        </padding>
        <CheckBox fx:id="readonly"
                  text="%checkbox.readonly"
                  selected="true"
                  onAction="#onReadonlyModeToggle"/>
        <Button text="%button.close" onAction="#onCloseButtonClick"/>
    </HBox>
</VBox>
